{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "osrm-routed --algorithm mld --max-matching-size 5000 --ip 0.0.0.0 --port ${PORT:-5000} /data/california-latest.osrm",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
